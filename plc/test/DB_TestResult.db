DATA_BLOCK "DB_TestResult"
TITLE = Result of the self-checking test bench
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : chad416
VERSION : 0.1
NON_RETAIN
   VAR
      Done : Bool;   // the bench has finished and holds its result
      AllPassed : Bool;   // Done, every case run, none failed
      CasesTotal : Int;
      CasesRun : Int;
      CasesPassed : Int;
      CasesFailed : Int;
      FirstFailedCase : Int;   // 0 = none
      FirstFailedCheck : Int;   // 0 = none; numbers in "FB_TestBench"
      Calls : DInt;   // calls of the bench until it was done
      CasePass : Array[1..32] of Bool;   // one bit per case; bits above CasesTotal stay FALSE
   END_VAR

BEGIN

END_DATA_BLOCK

      #ExpMarkStarts := 3;
      #ExpJobSum := 615;
      #ExpSerialLast := 33;
      #ExpGood := 2;
      #ExpVoid := 1;
      #ExpRecSerialSum := 96;
      #ExpCodeSum := 30426;
   ELSIF #CaseNo = 15 THEN

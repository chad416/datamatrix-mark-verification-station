      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702052;
         #VarCode := 4;
      ELSIF #PartIx = 3 THEN
         #PartNo := 83702052;
         #VarCode := 4;
      END_IF;
      #ExpReleased := 2;
      #ExpRejected := 1;
      #ExpRemoved := 0;
      #ExpAlarmSum := 2;
      #ExpMarkStarts := 2;
      #ExpJobSum := 411;
      #ExpSerialLast := 24;
      #ExpGood := 2;
      #ExpVoid := 1;
      #ExpRecSerialSum := 69;
      #ExpCodeSum := 20225;
   ELSIF #CaseNo = 12 THEN

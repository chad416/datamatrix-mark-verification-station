         #PartNo := 12345678;
         #VarCode := 1;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 1;
      #ExpRejected := 1;
      #ExpRemoved := 0;
      #ExpAlarmSum := 1;
      #ExpMarkStarts := 1;
      #ExpJobSum := 205;
      #ExpSerialLast := 10;
      #ExpGood := 1;
      #ExpVoid := 0;
      #ExpRecSerialSum := 10;
      #ExpCodeSum := 10104;
   ELSIF #CaseNo = 5 THEN
      // no-read once, second read succeeds: parts A
      #NParts := 1;
      #FaultKind := 10;
      #FaultPart := 1;
      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 1;
      #ExpRejected := 0;
      #ExpRemoved := 0;
      #ExpAlarmSum := 0;
      #ExpMarkStarts := 1;
      #ExpJobSum := 205;
      #ExpSerialLast := 11;
      #ExpGood := 1;
      #ExpVoid := 0;
      #ExpRecSerialSum := 11;

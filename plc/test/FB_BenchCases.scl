      END_IF;
      #ExpReleased := 3;
      #ExpRejected := 0;
      #ExpRemoved := 0;
      #ExpAlarmSum := 0;
      #ExpMarkStarts := 3;
      #ExpJobSum := 428;
      #ExpSerialLast := 4;
      #ExpGood := 3;
      #ExpVoid := 0;
      #ExpRecSerialSum := 9;
      #ExpCodeSum := 30118;
   ELSIF #CaseNo = 3 THEN
      // changeover back and forth: parts B B A C A
      #NParts := 5;
      #FaultKind := 0;
      #FaultPart := 0;
      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702052;
         #VarCode := 4;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702052;
         #VarCode := 4;
      ELSIF #PartIx = 3 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 4 THEN
         #PartNo := 83700017;
         #VarCode := 17;
      ELSIF #PartIx = 5 THEN
         #PartNo := 83702051;
         #VarCode := 17;

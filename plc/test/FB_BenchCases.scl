FUNCTION_BLOCK "FB_BenchCases"
TITLE = Scenario table and expected values of the test bench (generated)
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : chad416
VERSION : 0.1
//  GENERATED by scripts/make_testbench.py from dmx/bench.py. Do not edit by hand.
//  The expected values are the outcomes of the Python model (dmx/explore.py with the station
//  block in the loop, dmx/ecc200.py for the code content), not of the SCL stand-ins.
//  CaseNo selects the case, PartIx the part inside the case, Row a row of the recipe table.
   VAR_INPUT
      CaseNo : Int;
      PartIx : Int;
      Row : Int;
   END_VAR

   VAR_OUTPUT
      CasesTotal : Int;
      NParts : Int;   // parts in this case
      FaultKind : Int;   // see "FB_SimMarker"; 10 no-read once, 11 no-read always, 12 part taken out, 13 slow record store
      FaultPart : Int;   // the part that gets the fault
      FaultArg : Int;   // fault 12: station step in which the part is taken out
      PartNo : DInt;   // part PartIx of this case
      VarCode : Int;
      RowPartNo : DInt;   // recipe row Row: the job of row n has the number n
      RowVarCode : Int;
      RowJob : Int;
      TmoLoad : Int;   // station time-outs for the bench, in calls
      TmoMark : Int;
      TmoRead : Int;
      TmoRec : Int;
      MaxReads : Int;
      ExpReleased : Int;
      ExpRejected : Int;
      ExpRemoved : Int;
      ExpAlarmSum : Int;
      ExpMarkStarts : Int;
      ExpJobSum : DInt;
      ExpSerialLast : DInt;
      ExpGood : Int;
      ExpVoid : Int;
      ExpRecSerialSum : DInt;
      ExpCodeSum : DInt;
   END_VAR

BEGIN
   #CasesTotal := 21;
   #TmoLoad := 3;
   #TmoMark := 4;
   #TmoRead := 3;
   #TmoRec := 3;
   #MaxReads := 2;

   REGION RecipeRow
   IF #Row >= 1 AND #Row <= 320 THEN
      #RowPartNo := 83700000 + INT_TO_DINT(#Row);
      #RowVarCode := #Row MOD 50;
      #RowJob := #Row;
   ELSE
      #RowPartNo := 0;
      #RowVarCode := 0;
      #RowJob := 0;
   END_IF;
   IF #Row = 205 THEN
      #RowPartNo := 83702051;
      #RowVarCode := 17;
   ELSIF #Row = 206 THEN
      #RowPartNo := 83702052;
      #RowVarCode := 4;
   END_IF;
   END_REGION

   REGION Cases
   #NParts := 0;
   #FaultKind := 0;
   #FaultPart := 0;
   #FaultArg := 0;
   #PartNo := 0;
   #VarCode := 0;
   #ExpReleased := 0;
   #ExpRejected := 0;
   #ExpRemoved := 0;
   #ExpAlarmSum := 0;
   #ExpMarkStarts := 0;
   #ExpJobSum := 0;
   #ExpSerialLast := 0;
   #ExpGood := 0;
   #ExpVoid := 0;
   #ExpRecSerialSum := 0;
   #ExpCodeSum := 0;
   IF #CaseNo = 1 THEN
      // good cycle: parts A
      #NParts := 1;
      #FaultKind := 0;
      #FaultPart := 0;
      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 1;
      #ExpRejected := 0;
      #ExpRemoved := 0;
      #ExpAlarmSum := 0;
      #ExpMarkStarts := 1;
      #ExpJobSum := 205;
      #ExpSerialLast := 1;
      #ExpGood := 1;
      #ExpVoid := 0;
      #ExpRecSerialSum := 1;
      #ExpCodeSum := 10105;
   ELSIF #CaseNo = 2 THEN
      // three part types in a row: parts A B C
      #NParts := 3;
      #FaultKind := 0;
      #FaultPart := 0;
      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702052;

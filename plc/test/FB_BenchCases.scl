      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 1;

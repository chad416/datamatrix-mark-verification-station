      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 1;
      #ExpRejected := 1;
      #ExpRemoved := 0;
      #ExpAlarmSum := 3;
      #ExpMarkStarts := 2;
      #ExpJobSum := 410;
      #ExpSerialLast := 19;
      #ExpGood := 1;
      #ExpVoid := 1;
      #ExpRecSerialSum := 37;
      #ExpCodeSum := 20378;
   ELSIF #CaseNo = 10 THEN
      // marker fault during marking, then a good part: parts A A
      #NParts := 2;
      #FaultKind := 4;

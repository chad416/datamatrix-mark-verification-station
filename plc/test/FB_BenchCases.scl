      #ExpRemoved := 0;
      #ExpAlarmSum := 3;
      #ExpMarkStarts := 2;
      #ExpJobSum := 410;
      #ExpSerialLast := 21;
      #ExpGood := 1;
      #ExpVoid := 1;
      #ExpRecSerialSum := 41;
      #ExpCodeSum := 20236;
   ELSIF #CaseNo = 11 THEN

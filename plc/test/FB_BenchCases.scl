      #ExpRemoved := 0;
      #ExpAlarmSum := 2;
      #ExpMarkStarts := 2;
      #ExpJobSum := 410;
      #ExpSerialLast := 30;
      #ExpGood := 2;
      #ExpVoid := 1;
      #ExpRecSerialSum := 87;
      #ExpCodeSum := 20315;
   ELSIF #CaseNo = 14 THEN
      // stale serial, wrong echo: parts A A A
      #NParts := 3;
      #FaultKind := 8;
      #FaultPart := 2;
      #FaultArg := 0;
      IF #PartIx = 1 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 2 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      ELSIF #PartIx = 3 THEN
         #PartNo := 83702051;
         #VarCode := 17;
      END_IF;
      #ExpReleased := 2;
